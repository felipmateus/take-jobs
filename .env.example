# Copy to .env to override. Every key is optional: without a value the default below applies.
# A key set to an empty value is passed through as empty, not replaced by the default.

# Port published on the host for the API.
API_PORT=8000

# PostgreSQL (development defaults; the database port is not published to the host).
POSTGRES_USER=take_jobs
POSTGRES_PASSWORD=take_jobs_dev
POSTGRES_DB=take_jobs
# Database the API, migrations and collector connect to. Update it together with the three keys above.
DATABASE_URL=postgresql+asyncpg://take_jobs:take_jobs_dev@db:5432/take_jobs

# Collection schedule (standard 5-field cron; day-of-week 0 or 7 = Sunday).
SCRAPE_CRON=0 6 * * *
# Time zone for SCRAPE_CRON and for date query parameters.
SCRAPE_TIMEZONE=America/Sao_Paulo
# Collect on start when the job store is empty or no run finished in the last 24 h.
SCRAPE_ON_START=true
# Run time budget in minutes (>= 20); the crawl stops 10 minutes before it.
SCRAPE_RUN_TIMEOUT_MINUTES=60

# Search terms collected on every source (comma-separated, must not be empty).
SCRAPE_TERMS=desenvolvedor,programador,engenheiro de software,desenvolvedor backend,desenvolvedor frontend,desenvolvedor full stack,desenvolvedor mobile,desenvolvedor python,desenvolvedor java,desenvolvedor javascript,desenvolvedor .net,desenvolvedor php

# Max listing pages per source and term per run (>= 1).
SCRAPE_MAX_PAGES=20
# Minimum seconds between two requests to the same site (>= 1.0).
SCRAPE_DOWNLOAD_DELAY=1.0
# User-Agent sent to the sites.
SCRAPE_USER_AGENT=take-jobs/2.0 (+https://github.com/felipmateus/take-jobs)

# A title must contain one of these to be stored (comma-separated, case- and accent-insensitive; must not be empty).
RELEVANCE_INCLUDE_KEYWORDS=desenvolvedor,desenvolvedora,developer,programador,programadora,programmer,engenheiro de software,engenheira de software,software engineer,dev,backend,back-end,frontend,front-end,full stack,fullstack,full-stack
# A title containing one of these is discarded (may be empty to disable exclusions).
RELEVANCE_EXCLUDE_KEYWORDS=cnc,torno,usinagem,producao,pcp,manutencao,negocios,vendas,comercial,textil,moda,costura,transporte,transportes,cargas,programador de logistica,laser,plasma,puncionadeira,dobradeira,corte,dobra,comando numerico,materiais,programador visual,programador de servicos,programador operacional,rotas,frota,mao de obra,nesting,bordado,cad,injetora,eletricista,clp,plc,bordados,fornecedores,carteira de clientes,vendedor,vendedora,programador de ligacao

# Days without being seen before a job is inactive (>= 1).
JOB_INACTIVE_AFTER_DAYS=7

# Log verbosity of all services (DEBUG, INFO, WARNING, ERROR, CRITICAL).
LOG_LEVEL=INFO
